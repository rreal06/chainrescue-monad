# Monad Testnet public RPC endpoint (or a provider endpoint you control)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Never commit a funded private key. Include the 0x prefix.
DEPLOYER_PRIVATE_KEY=
# Address printed by a successful deployment; used by the verifier setup script.
CHAIN_RESCUE_ADDRESS=
# Two independent demo wallets to authorize for the verification step.
VERIFIER_ONE_ADDRESS=
VERIFIER_TWO_ADDRESS=

# Set after a successful Monad Testnet deployment.
VITE_CHAIN_RESCUE_ADDRESS=
# Defaults to the public Monad Testnet endpoint when omitted.
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Demo examples appear only while no deployed address is configured.
VITE_DEMO_MODE=true
